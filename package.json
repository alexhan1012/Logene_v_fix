{
  "name": "logene",
  "version": "1.0.0",
  "description": "Knowledge base for IT support engineers",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "antd": "^5.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.0",
    "electron-store": "^8.1.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.5.1",
    "multer": "^2.1.1",
    "openai": "^4.0.0",
    "pg": "^8.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
